{
  "name": "@brachkow/hono-inertia",
  "version": "3.1.0",
  "description": "Inertia.js v3 server-side adapter for Hono",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      }
    },
    "./vite-plugin": {
      "import": {
        "types": "./dist/vite-plugin.d.ts",
        "default": "./dist/vite-plugin.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./vite-plugin/client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "author": "brachkow",
  "repository": {
    "type": "git",
    "url": "https://github.com/brachkow/hono-inertia.git",
    "directory": "packages/hono-inertia"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cp ../../README.md README.md && tsdown",
    "prepublishOnly": "pnpm test && pnpm typecheck",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lowest.json && tsc --noEmit -p tsconfig.hono-5.json",
    "size": "pnpm build && size-limit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@inertiajs/vue3": ">=3.0.0",
    "hono": ">=4.8.0 || >=5.0.0-rc.1",
    "vite": ">=7.0.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.9.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "hono": "catalog:",
    "hono-4.8.0": "npm:hono@4.8.0",
    "hono-5": "npm:hono@5.0.0-rc.1",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-7.0.0": "npm:vite@7.0.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "keywords": [
    "hono",
    "inertia",
    "inertiajs",
    "adapter",
    "middleware"
  ],
  "peerDependenciesMeta": {
    "@inertiajs/vue3": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
