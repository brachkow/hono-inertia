  },
  {
    "name": "vite entry",
    "path": "dist/vite.js",
    "import": "*",
    "limit": "1 kB"
  },
  {
    "name": "testing entry",
    "path": "dist/testing.js",
    "import": "*",
    "limit": "1 kB"
  },
  {
    "name": "vue entry",
    "path": "dist/vue.js",
    "import": "*",
    "ignore": ["@inertiajs/vue3", "vue"],
    "limit": "1 kB"
  }
]
