{
  "name": "hono-inertia-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @brachkow/hono-inertia build",
    "test": "pnpm --filter @brachkow/hono-inertia test",
    "build:examples": "pnpm --filter \"{./examples/*}...\" build",
    "test:e2e": "pnpm build:examples && pnpm --filter e2e test",
    "typecheck": "pnpm -r typecheck",
    "size": "pnpm --filter @brachkow/hono-inertia size",
    "test:format": "prettier --check .",
    "fix:format": "prettier --write .",
    "test:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "fetch:inertia": "bash scripts/fetch-inertia.sh",
    "fetch:inertia-laravel": "bash scripts/fetch-inertia-laravel.sh"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-fans": "^1.11.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "catalog:"
  }
}
