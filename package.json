{
  "name": "@brachkow/hono-inertia",
  "version": "3.1.0",
  "description": "Inertia.js v3 server-side adapter for Hono",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "author": "brachkow",
  "repository": {
    "type": "git",
    "url": "https://github.com/brachkow/hono-inertia.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsdown",
    "prepublishOnly": "pnpm test && pnpm typecheck",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:format": "prettier --check .",
    "fix:format": "prettier --write .",
    "test:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "size": "pnpm build && size-limit",
    "fetch:inertia": "bash scripts/fetch-inertia.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "hono": ">=4.8.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.1.0",
    "eslint": "^10.12.0",
    "eslint-config-fans": "^1.11.0",
    "hono": "^4.12.8",
    "hono-4.8.0": "npm:hono@4.8.0",
    "hono-5": "npm:hono@5.0.0-rc.1",
    "prettier": "^3.9.10",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "license": "MIT",
  "keywords": [
    "hono",
    "inertia",
    "inertiajs",
    "adapter",
    "middleware"
  ]
}
